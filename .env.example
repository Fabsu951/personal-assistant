# Copy to .env for local runs. On Railway, put these under Variables instead.

# Required
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=

# Only this Telegram user may talk to the bot (the bot tells you your ID on first message)
OWNER_TELEGRAM_ID=

# Google (Gmail, Calendar, Drive) - connect with /connect_google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Strava (workouts from your watch) - connect with /connect_strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Voice messages (speech-to-text). Leave empty to switch voice off.
OPENAI_API_KEY=
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Spoken replies: auto (voice in -> voice out), always or off. Also /voice in Telegram.
# VOICE_REPLIES=auto
# Voice messages get short answers with less thinking, for speed.
# VOICE_EFFORT=low
# VOICE_MODEL=claude-haiku-5-5   (even faster and cheaper, a bit less smart)
# TTS_VOICE=onyx
# TTS_STYLE=Warm, cheerful and upbeat (Ragnar can also change voice and tone when you ask)

# Hands-free voice page: set automatically on Railway after 'Generate Domain'.
# WEB_URL=https://your-app.up.railway.app
# PORT=8080

# Optional
MODEL=claude-sonnet-5-5
TIMEZONE=Asia/Taipei
ASSISTANT_NAME=Ragnar
OWNER_NAME=Fabian
# Morning briefing time (HH:MM), or "off"
BRIEFING_TIME=07:30
# Weekly training review on Sundays (HH:MM), or "off"
WEEKLY_REVIEW_TIME=19:00
ENABLED_SKILLS=google,tasks,research,admin,fitness
# DATA_DIR=/data   (default: /data if a volume is mounted there, else ./data)
# HISTORY_TURNS=20
EXTRA_INSTRUCTIONS=
