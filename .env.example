# Copy to .env for local runs. On Railway, put these under Variables instead.

# Required
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=

# Only this Telegram user may talk to the bot (the bot tells you your ID on first message)
OWNER_TELEGRAM_ID=

# Google (Gmail, Calendar, Drive) - connect with /connect_google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Voice messages (speech-to-text). Leave empty to switch voice off.
OPENAI_API_KEY=
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional
MODEL=claude-sonnet-5-5
TIMEZONE=Asia/Taipei
ASSISTANT_NAME=Ragnar
OWNER_NAME=Fabian
# Morning briefing time (HH:MM), or "off"
BRIEFING_TIME=07:30
ENABLED_SKILLS=google,tasks,research,admin,fitness
# DATA_DIR=/data   (default: /data if a volume is mounted there, else ./data)
# HISTORY_TURNS=20
EXTRA_INSTRUCTIONS=
